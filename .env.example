POSTGRES_USER=postgres
# IMPORTANT: only applied when the postgres_data volume is first created.
# To change later: ALTER USER postgres PASSWORD '...' inside the container,
# and keep this value in sync. See deploy/README.md.
# Generate one: openssl rand -hex 16
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=campaign_buddy

STAFF_JWT_SECRET=change-me-staff-secret
STAFF_JWT_EXPIRES_IN=86400
STAFF_REFRESH_TOKEN_TTL_DAYS=30

USER_JWT_SECRET=change-me-user-secret
USER_JWT_EXPIRES_IN=8h

BCRYPT_SALT_ROUNDS=10

# License usage tracking (docs/license-usage-spec.md) — both optional
LICENSE_WARN_THRESHOLD_PCT=80
LICENSE_SNAPSHOT_DISABLED=0

# Timezone for the backend container (the daily license-usage snapshot job
# buckets weeks/months in this zone).
TZ=Asia/Colombo

# Cloudflare Tunnel token — DO NOT commit a real value. Paste yours into the
# untracked `.env` only.
CLOUDFLARED_TUNNEL_TOKEN=
