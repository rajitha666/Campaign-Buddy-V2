# --- Campaign Buddy backend the MCP server talks to (the /admin/v1 API) ---
CB_API_BASE_URL=http://localhost:4000

# Portal user the MCP server acts as. Use a DEDICATED user, not a person's login:
# its role (adm/usr/supervisor/sponsor) + campaign grants define everything the
# LLM can see or do — the backend enforces it, not this server.
CB_USERNAME=
CB_PASSWORD=

# Start read-only (recommended): 1 = read tools only. Set 0 only for a usr/adm service user once you want the write tools (each still needs human approval).
CB_MCP_READ_ONLY=1

# --- HTTP transport (npm run start:http) ---
CB_MCP_HTTP_PORT=4300
CB_MCP_HTTP_HOST=127.0.0.1
# Bearer token clients must send to the HTTP endpoint. Required for http mode.
CB_MCP_HTTP_TOKEN=

# --- Intelligence client (npm run intel) ---
ANTHROPIC_API_KEY=
CB_INTEL_MODEL=claude-opus-5
