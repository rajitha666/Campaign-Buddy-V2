# Fine-grained PAT scoped to Campaign-Buddy-V2 only:
#   Issues: Read and write, Metadata: Read (required)
#   Projects: Read and write (only if you use PROJECT_NUMBER below)
# Classic PAT alternative: "repo" + "project" scopes.
GITHUB_TOKEN=

# owner/repo of the issue tracker
GITHUB_REPO=rajitha666/Campaign-Buddy-V2

# Anthropic API key used for the triage reasoning calls
ANTHROPIC_API_KEY=

# Optional: number of a GitHub Projects v2 board (user-owned) with a
# single-select "Status" field whose options are named exactly:
# New, Needs Info, Ready for Review, In Build
# Leave blank to skip project-board sync and rely on labels only.
PROJECT_NUMBER=

# claude-sonnet-5 by default; override to try a different model
TRIAGE_MODEL=claude-sonnet-5

# true = analyze and log planned comments/labels but never write to GitHub
DRY_RUN=true
