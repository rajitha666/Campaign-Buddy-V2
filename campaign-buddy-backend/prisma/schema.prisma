// ============================================================================
// Campaign Buddy — Unified Backend Schema (v3)
// Serves: Mobile app (Staff), Admin/Supervisor/Sponsor web portal (User)
// Canonical stack: Node.js / Express / PostgreSQL / Prisma — confirmed v3.
// See docs/backend-spec.md for the design rationale and
// docs/changelog.md for what changed from the prior schema and why.
//
// RETIRED: docs/archive/full-backend-contract.md described a PHP(Slim 3)/MySQL
// stack. That was never implemented and is not the target — this Prisma/
// PostgreSQL schema is canonical. Full Backend Contract is kept only as a
// historical decision-log reference (see Changelog v3).
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum CampaignStatus {
  upcoming
  active
  ended
}

enum StaffType {
  promoter
  supervisor
}

enum StaffStatus {
  active
  inactive
}

enum TargetType {
  item_wise
  brand_wise
}

enum TargetCategorization {
  daily
  monthly
}

enum TargetUnit {
  unit_wise
  sales_wise
}

enum AttendanceStatus {
  on_time
  late
  leave
  absent
  pending
}

enum AppState {
  foreground
  background
}

enum LeaveReason {
  sick_leave
  annual_leave
  personal
  other
}

enum LeaveStatus {
  pending
  approved
  declined
}

enum SupervisorTaskType {
  range
  feedback
}

enum OutletScopeType {
  all
  subset
}

// Period granularity for stored license-usage snapshots (license usage tracking).
enum LicenseUsagePeriod {
  week
  month
}

// Admin-defined extra fields captured on the daily sales update (issue #13).
enum SalesFieldType {
  number
  text
  boolean
  select
}

enum SalesFieldScope {
  day // one value per activation per day  (mobile: Daily Sales screen)
  product // one value per activation-item per day (mobile: Update Stock screen)
}

// Portal "Report an issue" — see docs/issue-reporting-spec.md.
enum IssueReportCategory {
  bug
  enhancement
  question
}

enum IssueReportSeverity {
  low
  normal
  high
  critical
}

enum IssueReportSyncStatus {
  pending // not yet sent to GitHub (or GitHub integration disabled)
  synced // an issue was created on GitHub
  failed // last send attempt errored; the retry job will try again
}

// ============================================================================
// Catalog: Client / Brand / Item
// ============================================================================

model Client {
  id            String   @id @default(uuid())
  companyName   String
  clientName    String
  contactNumber String?
  email         String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  brands    Brand[]
  campaigns Campaign[]

  @@map("clients")
}

model Brand {
  id        String   @id @default(uuid())
  name      String
  clientId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items  Item[]

  @@index([clientId])
  @@map("brands")
}

model Item {
  id           String   @id @default(uuid())
  brandId      String
  sku          String
  name         String
  unitPrice    Int // integer LKR
  reorderLevel Int      @default(0)
  imageUrl     String?
  description  String?
  attributes   String[] @default([])
  supplierName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brand         Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignItems CampaignItem[]

  @@unique([brandId, sku])
  @@index([brandId])
  @@map("items")
}

// ============================================================================
// Geography
// ============================================================================

model City {
  id       String @id @default(uuid())
  name     String
  province String
  district String

  outlets           Outlet[]
  distributorPoints DistributorPoint[]
  staff             Staff[]

  @@map("cities")
}

model Outlet {
  id                   String   @id @default(uuid())
  outletNo             String   @unique
  name                 String
  contactPerson        String?
  address              String?
  cityId               String
  phone                String?
  mobile               String?
  fax                  String?
  latitude             Float
  longitude            Float
  geofenceRadiusMeters Int      @default(150)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  city        City         @relation(fields: [cityId], references: [id])
  activations Activation[]

  @@index([cityId])
  @@map("outlets")
}

model DistributorPoint {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  address   String?
  cityId    String
  clientId  String
  createdAt DateTime @default(now())

  city        City         @relation(fields: [cityId], references: [id])
  activations Activation[]

  @@index([cityId])
  @@index([clientId])
  @@map("distributor_points")
}

// ============================================================================
// Staff (mobile login) — Promoters & Supervisors
// ============================================================================
//
// HR profile scope confirmed v3: this is the FULL and FINAL field set for
// this version — the ~30-field form referenced in earlier Admin Panel audit
// notes (marital status, English proficiency, work details, designation,
// profile photo upload) is explicitly OUT OF SCOPE, not a gap. See Changelog
// v3 "Staff HR fields" for the record of this decision.

model Staff {
  id               String      @id @default(uuid())
  employeeId       String      @unique
  fullName         String
  displayName      String
  userType         StaffType
  mobileUsername   String      @unique
  passwordHash     String
  phone            String?
  cityId           String?
  status           StaffStatus @default(active)
  reportsToStaffId String?
  linkedUserId     String?     @unique // set when this Staff (typically a supervisor) also has a web portal login

  // HR profile sub-fields (flattened; not consumed by mobile/admin APIs in v1, profile-management only)
  nic                   String?
  dateOfBirth           DateTime?
  gender                String?
  permanentAddress      String?
  currentAddress        String?
  emergencyContactName  String?
  emergencyContactPhone String?
  bankAccountName       String?
  bankName              String?
  bankAccountNumber     String?
  bankBranch            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city             City?               @relation(fields: [cityId], references: [id])
  reportsTo        Staff?              @relation("StaffReportsTo", fields: [reportsToStaffId], references: [id])
  reports          Staff[]             @relation("StaffReportsTo")
  linkedUser       User?               @relation(fields: [linkedUserId], references: [id])
  activations      Activation[]        @relation("ActivationStaff")
  supervising      Activation[]        @relation("ActivationSupervisor")
  refreshTokens    StaffRefreshToken[]
  leaveRequests    LeaveRequest[]
  supervisorRoutes SupervisorRoute[]

  @@index([cityId])
  @@index([reportsToStaffId])
  @@map("staff")
}

model StaffRefreshToken {
  id        String    @id @default(uuid())
  staffId   String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_refresh_tokens")
}

// ============================================================================
// Campaign / Activation (the tenancy boundary)
// ============================================================================
//
// Campaign.status confirmed v3: stored column (matches implemented behavior),
// NOT purely computed-at-read as one prior draft doc suggested. It is kept in
// sync with startDate/endDate automatically (recomputed whenever the campaign
// row is read or written), but an Admin/Campaign Admin may also override it
// manually (e.g. to end a campaign early) — see Backend Spec v3 §5.8.

model Campaign {
  id                String         @id @default(uuid())
  campaignNo        String         @unique
  name              String
  clientId          String
  description       String?
  startDate         DateTime
  endDate           DateTime
  status            CampaignStatus @default(upcoming)
  // Set when an adm/usr sets `status` explicitly via PATCH. While true, the
  // date-derived auto-sync (§5.8) leaves `status` alone; changing startDate or
  // endDate clears it so the date rule takes over again.
  statusManuallySet Boolean        @default(false)
  timezone          String         @default("Asia/Colombo")

  // License usage tracking — named seat caps per user group, soft-limit only
  // (over-cap never blocks assignment, it just raises an alert state). Defaults
  // match the standard campaign profile (20 promoters / 5 supervisors / 2 admins
  // / 2 sponsors). `licenseWarnThresholdPct` null => fall back to the global
  // default (env LICENSE_WARN_THRESHOLD_PCT, itself defaulting to 80).
  // See docs/license-usage-spec.md.
  licensePromoterCap      Int  @default(20)
  licenseSupervisorCap    Int  @default(5)
  licenseAdminCap         Int  @default(2)
  licenseSponsorCap       Int  @default(2)
  licenseWarnThresholdPct Int?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  client                Client                 @relation(fields: [clientId], references: [id])
  campaignItems         CampaignItem[]
  activations           Activation[]
  accessGrants          CampaignAccessGrant[]
  supervisorTasks       SupervisorTask[]
  supervisorRoutes      SupervisorRoute[]
  salesFieldDefinitions SalesFieldDefinition[]
  licenseUsageSnapshots CampaignLicenseUsageSnapshot[]

  @@index([clientId])
  @@map("campaigns")
}

// One stored license-usage reading for a campaign over a calendar period.
// Written daily by the in-process snapshot job (src/jobs/licenseSnapshot.ts):
// each of the four `*Used` counts is the PEAK seen for that group during the
// period, `*Cap` is the cap as configured at capture time (so historical rows
// stay meaningful after a cap is changed). Periods are computed in Asia/Colombo
// (week = ISO Mon–Sun, month = calendar month). See docs/license-usage-spec.md.
model CampaignLicenseUsageSnapshot {
  id             String             @id @default(uuid())
  campaignId     String
  period         LicenseUsagePeriod
  periodStart    DateTime           @db.Date
  promoterUsed   Int                @default(0)
  supervisorUsed Int                @default(0)
  adminUsed      Int                @default(0)
  sponsorUsed    Int                @default(0)
  promoterCap    Int                @default(0)
  supervisorCap  Int                @default(0)
  adminCap       Int                @default(0)
  sponsorCap     Int                @default(0)
  capturedAt     DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, period, periodStart])
  @@index([campaignId])
  @@map("campaign_license_usage_snapshots")
}

model CampaignItem {
  id         String   @id @default(uuid())
  campaignId String
  itemId     String
  addedAt    DateTime @default(now())

  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  item            Item             @relation(fields: [itemId], references: [id])
  activationItems ActivationItem[]

  @@unique([campaignId, itemId])
  @@index([campaignId])
  @@map("campaign_items")
}

model Activation {
  id                   String               @id @default(uuid())
  name                 String
  campaignId           String
  outletId             String
  staffId              String
  supervisorStaffId    String?
  distributorPointId   String?
  dateFrom             DateTime
  dateTo               DateTime
  targetType           TargetType           @default(item_wise)
  targetCategorization TargetCategorization @default(daily)
  targetUnit           TargetUnit           @default(unit_wise)
  shiftStart           DateTime?
  shiftEnd             DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  outlet           Outlet            @relation(fields: [outletId], references: [id])
  staff            Staff             @relation("ActivationStaff", fields: [staffId], references: [id])
  supervisor       Staff?            @relation("ActivationSupervisor", fields: [supervisorStaffId], references: [id])
  distributorPoint DistributorPoint? @relation(fields: [distributorPointId], references: [id])

  activationItems   ActivationItem[]
  activationTargets ActivationTarget[]
  attendanceRecords AttendanceRecord[]
  dailyStats        DailyStats[]
  salesSummaries    SalesSummary[]
  trackingPings     TrackingPing[]
  salesFieldValues  SalesFieldValue[]

  @@index([campaignId])
  @@index([outletId])
  @@index([staffId])
  @@index([supervisorStaffId])
  @@map("activations")
}

model ActivationItem {
  id             String   @id @default(uuid())
  activationId   String
  campaignItemId String
  addedAt        DateTime @default(now())

  activation       Activation        @relation(fields: [activationId], references: [id], onDelete: Cascade)
  campaignItem     CampaignItem      @relation(fields: [campaignItemId], references: [id])
  salesRecords     SalesRecord[]
  salesFieldValues SalesFieldValue[]

  @@unique([activationId, campaignItemId])
  @@index([activationId])
  @@map("activation_items")
}

model ActivationTarget {
  id           String   @id @default(uuid())
  activationId String
  dateFrom     DateTime
  dateTo       DateTime
  repeat       Boolean  @default(false)
  targetItemId String
  targetValue  Int
  createdAt    DateTime @default(now())

  activation Activation @relation(fields: [activationId], references: [id], onDelete: Cascade)

  @@index([activationId])
  @@map("activation_targets")
}

// ============================================================================
// Daily operational data (attendance, stock/sales, stats, tracking, leave)
// ============================================================================
//
// Geofence enforcement confirmed v3: SOFT FLAG ONLY. checkInLocationVerified
// is set to false when the check-in falls outside geofenceRadiusMeters, but
// check-in is NEVER rejected on that basis. See Backend Spec v3 §5.6.

model AttendanceRecord {
  id                              String           @id @default(uuid())
  activationId                    String
  date                            DateTime         @db.Date
  checkInAt                       DateTime?
  checkInLat                      Float?
  checkInLng                      Float?
  checkInLocationVerified         Boolean          @default(false)
  checkOutAt                      DateTime?
  checkOutLat                     Float?
  checkOutLng                     Float?
  salesSummaryConfirmedAtCheckout Boolean          @default(false)
  status                          AttendanceStatus @default(pending)
  leaveRequestId                  String?
  createdAt                       DateTime         @default(now())
  updatedAt                       DateTime         @updatedAt

  activation   Activation    @relation(fields: [activationId], references: [id], onDelete: Cascade)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id])

  @@unique([activationId, date])
  @@index([activationId])
  @@map("attendance_records")
}

model SalesRecord {
  id                       String   @id @default(uuid())
  activationItemId         String
  date                     DateTime @db.Date
  openingStock             Int      @default(0)
  soldToday                Int      @default(0)
  otherInterestedCustomers Int      @default(0)
  reorderFlag              Boolean  @default(false)
  updatedAt                DateTime @updatedAt

  activationItem ActivationItem @relation(fields: [activationItemId], references: [id], onDelete: Cascade)

  @@unique([activationItemId, date])
  @@index([activationItemId])
  @@map("sales_records")
}

model DailyStats {
  id           String   @id @default(uuid())
  activationId String
  date         DateTime @db.Date
  footFall     Int      @default(0)
  approached   Int      @default(0)
  converted    Int      @default(0)
  updatedAt    DateTime @updatedAt

  activation Activation @relation(fields: [activationId], references: [id], onDelete: Cascade)

  @@unique([activationId, date])
  @@index([activationId])
  @@map("daily_stats")
}

model SalesSummary {
  id           String    @id @default(uuid())
  activationId String
  date         DateTime  @db.Date
  remarks      String?
  confirmed    Boolean   @default(false)
  confirmedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  activation Activation @relation(fields: [activationId], references: [id], onDelete: Cascade)

  @@unique([activationId, date])
  @@index([activationId])
  @@map("sales_summaries")
}

// Admin-defined extra field on the daily sales update, scoped to one campaign
// (issue #13). `key` is slugged from `label` at creation and then frozen so
// exports and stored values stay stable. Soft-deleted via `archivedAt`.
model SalesFieldDefinition {
  id         String          @id @default(uuid())
  campaignId String
  key        String
  label      String
  type       SalesFieldType
  scope      SalesFieldScope @default(day)
  options    String[]        @default([]) // `select` only, in display order
  required   Boolean         @default(false)
  sortOrder  Int             @default(0)
  archivedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  campaign Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  values   SalesFieldValue[]

  @@unique([campaignId, key])
  @@index([campaignId])
  @@map("sales_field_definitions")
}

// One captured value. `activationItemId` is null for `day`-scope definitions and
// set for `product`-scope. Two partial unique indexes (added in the migration,
// Prisma can't express them) keep one row per (definition, day) and per
// (definition, product, day). `value` is the canonical string form — see
// docs/custom-sales-fields-spec.md for the per-type encoding.
model SalesFieldValue {
  id               String   @id @default(uuid())
  definitionId     String
  activationId     String
  activationItemId String?
  date             DateTime @db.Date
  value            String
  updatedAt        DateTime @updatedAt

  definition     SalesFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  activation     Activation           @relation(fields: [activationId], references: [id], onDelete: Cascade)
  activationItem ActivationItem?      @relation(fields: [activationItemId], references: [id], onDelete: Cascade)

  @@index([activationId, date])
  @@index([definitionId])
  @@map("sales_field_values")
}

model TrackingPing {
  id             String   @id @default(uuid())
  activationId   String
  latitude       Float
  longitude      Float
  accuracyMeters Float?
  capturedAt     DateTime
  receivedAt     DateTime @default(now())
  appState       AppState @default(foreground)
  batteryPercent Int?

  activation Activation @relation(fields: [activationId], references: [id], onDelete: Cascade)

  @@index([activationId, capturedAt])
  @@map("tracking_pings")
}

model LeaveRequest {
  id         String      @id @default(uuid())
  staffId    String
  fromDate   DateTime    @db.Date
  toDate     DateTime    @db.Date
  reason     LeaveReason
  note       String?
  status     LeaveStatus @default(pending)
  approverId String?
  createdAt  DateTime    @default(now())
  decidedAt  DateTime?

  staff             Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]

  @@index([staffId])
  @@map("leave_requests")
}

model SupervisorTask {
  id         String             @id @default(uuid())
  campaignId String
  category   String
  taskType   SupervisorTaskType
  task       String
  createdAt  DateTime           @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("supervisor_tasks")
}

// SupervisorRoute — Assign Routes (supervisor route planning) — NEW in v3.
// Previously had no backend entity anywhere; built now per this pass's scope
// decision. Deliberately campaign-scoped (campaignId + outletIds within that
// campaign) rather than fully global, so it slots into the same
// requireCampaignAccess / CampaignAccessGrant enforcement as every other
// campaign-scoped resource, instead of needing a special-cased global route.
// See Backend Spec v3 §4.2 and §5.9, and Changelog v3.
model SupervisorRoute {
  id                String   @id @default(uuid())
  campaignId        String
  supervisorStaffId String
  outletIds         String[] @default([])
  dateFrom          DateTime @db.Date
  dateTo            DateTime @db.Date
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  supervisor Staff    @relation(fields: [supervisorStaffId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([supervisorStaffId])
  @@map("supervisor_routes")
}

// ============================================================================
// Web portal RBAC: User / Role / CampaignAccessGrant
// ============================================================================

model Role {
  id            String   @id // short code, e.g. "adm", "usr", "supervisor", "sponsor"
  label         String
  description   String?
  modules       String[] @default([])
  functionality String[] @default([])
  defaultUrl    String
  isActive      Boolean  @default(true)

  users User[]

  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  displayName  String
  email        String?
  roleId       String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role         Role                  @relation(fields: [roleId], references: [id])
  accessGrants CampaignAccessGrant[]
  staffProfile Staff?
  issueReports IssueReport[]

  @@index([roleId])
  @@map("users")
}

// A bug / enhancement / question raised from inside the web portal. Persisted
// here first, then mirrored to GitHub Issues by githubIssues.ts (inline on
// create, best-effort) or the issueSync job (retry). See
// docs/issue-reporting-spec.md.
model IssueReport {
  id                String                @id @default(uuid())
  title             String
  body              String
  category          IssueReportCategory   @default(bug)
  severity          IssueReportSeverity?  // only meaningful for category = bug
  context           Json? // { page, persona, campaignName, portalVersion, userAgent } — no PII beyond reporter display name
  reporterUserId    String
  reporterName      String // snapshot of User.displayName at report time
  syncStatus        IssueReportSyncStatus @default(pending)
  githubIssueNumber Int?
  githubIssueUrl    String?
  syncError         String? // last failure message, cleared on success
  syncAttempts      Int                   @default(0)
  lastAttemptAt     DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  reporter User @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([syncStatus])
  @@index([reporterUserId])
  @@map("issue_reports")
}

model CampaignAccessGrant {
  id         String          @id @default(uuid())
  userId     String
  campaignId String
  scopeType  OutletScopeType @default(all)
  outletIds  String[]        @default([]) // used only when scopeType = subset
  createdAt  DateTime        @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
  @@index([userId])
  @@index([campaignId])
  @@map("campaign_access_grants")
}
