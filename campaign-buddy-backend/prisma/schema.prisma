// ============================================================================
// Campaign Buddy — Unified Backend Schema (v3)
// Serves: Mobile app (Staff), Admin/Supervisor/Sponsor web portal (User)
// Canonical stack: Node.js / Express / PostgreSQL / Prisma — confirmed v3.
// See CampaignBuddy_Backend_Spec_v3.md for the design rationale and
// CampaignBuddy_Changelog_v3.md for what changed from the prior schema and why.
//
// RETIRED: CampaignBuddy_Full_Backend_Contract.md described a PHP(Slim 3)/MySQL
// stack. That was never implemented and is not the target — this Prisma/
// PostgreSQL schema is canonical. Full Backend Contract is kept only as a
// historical decision-log reference (see Changelog v3).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum CampaignStatus {
  upcoming
  active
  ended
}

enum StaffType {
  promoter
  supervisor
}

enum StaffStatus {
  active
  inactive
}

enum TargetType {
  item_wise
  brand_wise
}

enum TargetCategorization {
  daily
  monthly
}

enum TargetUnit {
  unit_wise
  sales_wise
}

enum AttendanceStatus {
  on_time
  late
  leave
  absent
  pending
}

enum AppState {
  foreground
  background
}

enum LeaveReason {
  sick_leave
  annual_leave
  personal
  other
}

enum LeaveStatus {
  pending
  approved
  declined
}

enum SupervisorTaskType {
  range
  feedback
}

enum OutletScopeType {
  all
  subset
}

// ============================================================================
// Catalog: Client / Brand / Item
// ============================================================================

model Client {
  id            String     @id @default(uuid())
  companyName   String
  clientName    String
  contactNumber String?
  email         String?
  address       String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  brands        Brand[]
  campaigns     Campaign[]

  @@map("clients")
}

model Brand {
  id        String   @id @default(uuid())
  name      String
  clientId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items  Item[]

  @@index([clientId])
  @@map("brands")
}

model Item {
  id            String   @id @default(uuid())
  brandId       String
  sku           String
  name          String
  unitPrice     Int // integer LKR
  reorderLevel  Int      @default(0)
  imageUrl      String?
  description   String?
  attributes    String[] @default([])
  supplierName  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  brand         Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignItems CampaignItem[]

  @@unique([brandId, sku])
  @@index([brandId])
  @@map("items")
}

// ============================================================================
// Geography
// ============================================================================

model City {
  id       String  @id @default(uuid())
  name     String
  province String
  district String

  outlets           Outlet[]
  distributorPoints DistributorPoint[]
  staff             Staff[]

  @@map("cities")
}

model Outlet {
  id                  String   @id @default(uuid())
  outletNo            String   @unique
  name                String
  contactPerson       String?
  address             String?
  cityId              String
  phone               String?
  mobile              String?
  fax                 String?
  latitude            Float
  longitude           Float
  geofenceRadiusMeters Int     @default(150)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  city        City         @relation(fields: [cityId], references: [id])
  activations Activation[]

  @@index([cityId])
  @@map("outlets")
}

model DistributorPoint {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  address   String?
  cityId    String
  clientId  String
  createdAt DateTime @default(now())

  city        City         @relation(fields: [cityId], references: [id])
  activations Activation[]

  @@index([cityId])
  @@index([clientId])
  @@map("distributor_points")
}

// ============================================================================
// Staff (mobile login) — Promoters & Supervisors
// ============================================================================
//
// HR profile scope confirmed v3: this is the FULL and FINAL field set for
// this version — the ~30-field form referenced in earlier Admin Panel audit
// notes (marital status, English proficiency, work details, designation,
// profile photo upload) is explicitly OUT OF SCOPE, not a gap. See Changelog
// v3 "Staff HR fields" for the record of this decision.

model Staff {
  id               String      @id @default(uuid())
  employeeId       String      @unique
  fullName         String
  displayName      String
  userType         StaffType
  mobileUsername   String      @unique
  passwordHash     String
  phone            String?
  cityId           String?
  status           StaffStatus @default(active)
  reportsToStaffId String?
  linkedUserId     String?     @unique // set when this Staff (typically a supervisor) also has a web portal login

  // HR profile sub-fields (flattened; not consumed by mobile/admin APIs in v1, profile-management only)
  nic                   String?
  dateOfBirth           DateTime?
  gender                String?
  permanentAddress      String?
  currentAddress        String?
  emergencyContactName  String?
  emergencyContactPhone String?
  bankAccountName       String?
  bankName              String?
  bankAccountNumber     String?
  bankBranch            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city         City?            @relation(fields: [cityId], references: [id])
  reportsTo    Staff?           @relation("StaffReportsTo", fields: [reportsToStaffId], references: [id])
  reports      Staff[]          @relation("StaffReportsTo")
  linkedUser   User?            @relation(fields: [linkedUserId], references: [id])
  activations  Activation[]     @relation("ActivationStaff")
  supervising  Activation[]     @relation("ActivationSupervisor")
  refreshTokens StaffRefreshToken[]
  leaveRequests LeaveRequest[]
  supervisorRoutes SupervisorRoute[]

  @@index([cityId])
  @@index([reportsToStaffId])
  @@map("staff")
}

model StaffRefreshToken {
  id        String   @id @default(uuid())
  staffId   String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_refresh_tokens")
}

// ============================================================================
// Campaign / Activation (the tenancy boundary)
// ============================================================================
//
// Campaign.status confirmed v3: stored column (matches implemented behavior),
// NOT purely computed-at-read as one prior draft doc suggested. It is kept in
// sync with startDate/endDate automatically (recomputed whenever the campaign
// row is read or written), but an Admin/Campaign Admin may also override it
// manually (e.g. to end a campaign early) — see Backend Spec v3 §5.8.

model Campaign {
  id         String         @id @default(uuid())
  campaignNo String         @unique
  name       String
  clientId   String
  description String?
  startDate  DateTime
  endDate    DateTime
  status     CampaignStatus @default(upcoming)
  // Set when an adm/usr sets `status` explicitly via PATCH. While true, the
  // date-derived auto-sync (§5.8) leaves `status` alone; changing startDate or
  // endDate clears it so the date rule takes over again.
  statusManuallySet Boolean  @default(false)
  timezone   String         @default("Asia/Colombo")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  client          Client                @relation(fields: [clientId], references: [id])
  campaignItems   CampaignItem[]
  activations     Activation[]
  accessGrants    CampaignAccessGrant[]
  supervisorTasks SupervisorTask[]
  supervisorRoutes SupervisorRoute[]

  @@index([clientId])
  @@map("campaigns")
}

model CampaignItem {
  id          String   @id @default(uuid())
  campaignId  String
  itemId      String
  addedAt     DateTime @default(now())

  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  item            Item             @relation(fields: [itemId], references: [id])
  activationItems ActivationItem[]

  @@unique([campaignId, itemId])
  @@index([campaignId])
  @@map("campaign_items")
}

model Activation {
  id                  String               @id @default(uuid())
  name                String
  campaignId          String
  outletId            String
  staffId             String
  supervisorStaffId   String?
  distributorPointId  String?
  dateFrom            DateTime
  dateTo              DateTime
  targetType          TargetType           @default(item_wise)
  targetCategorization TargetCategorization @default(daily)
  targetUnit          TargetUnit           @default(unit_wise)
  shiftStart          DateTime?
  shiftEnd            DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  campaign         Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  outlet           Outlet             @relation(fields: [outletId], references: [id])
  staff            Staff              @relation("ActivationStaff", fields: [staffId], references: [id])
  supervisor       Staff?             @relation("ActivationSupervisor", fields: [supervisorStaffId], references: [id])
  distributorPoint DistributorPoint?  @relation(fields: [distributorPointId], references: [id])

  activationItems   ActivationItem[]
  activationTargets ActivationTarget[]
  attendanceRecords AttendanceRecord[]
  dailyStats        DailyStats[]
  salesSummaries    SalesSummary[]
  trackingPings     TrackingPing[]

  @@index([campaignId])
  @@index([outletId])
  @@index([staffId])
  @@index([supervisorStaffId])
  @@map("activations")
}

model ActivationItem {
  id             String   @id @default(uuid())
  activationId   String
  campaignItemId String
  addedAt        DateTime @default(now())

  activation   Activation     @relation(fields: [activationId], references: [id], onDelete: Cascade)
  campaignItem CampaignItem   @relation(fields: [campaignItemId], references: [id])
  salesRecords SalesRecord[]

  @@unique([activationId, campaignItemId])
  @@index([activationId])
  @@map("activation_items")
}

model ActivationTarget {
  id           String   @id @default(uuid())
  activationId String
  dateFrom     DateTime
  dateTo       DateTime
  repeat       Boolean  @default(false)
  targetItemId String
  targetValue  Int
  createdAt    DateTime @default(now())

  activation Activation @relation(fields: [activationId], references: [id], onDelete: Cascade)

  @@index([activationId])
  @@map("activation_targets")
}

// ============================================================================
// Daily operational data (attendance, stock/sales, stats, tracking, leave)
// ============================================================================
//
// Geofence enforcement confirmed v3: SOFT FLAG ONLY. checkInLocationVerified
// is set to false when the check-in falls outside geofenceRadiusMeters, but
// check-in is NEVER rejected on that basis. See Backend Spec v3 §5.6.

model AttendanceRecord {
  id                             String            @id @default(uuid())
  activationId                   String
  date                           DateTime          @db.Date
  checkInAt                      DateTime?
  checkInLat                     Float?
  checkInLng                     Float?
  checkInLocationVerified        Boolean           @default(false)
  checkOutAt                     DateTime?
  checkOutLat                    Float?
  checkOutLng                    Float?
  salesSummaryConfirmedAtCheckout Boolean          @default(false)
  status                         AttendanceStatus  @default(pending)
  leaveRequestId                 String?
  createdAt                      DateTime          @default(now())
  updatedAt                      DateTime          @updatedAt

  activation    Activation     @relation(fields: [activationId], references: [id], onDelete: Cascade)
  leaveRequest  LeaveRequest?  @relation(fields: [leaveRequestId], references: [id])

  @@unique([activationId, date])
  @@index([activationId])
  @@map("attendance_records")
}

model SalesRecord {
  id                       String   @id @default(uuid())
  activationItemId         String
  date                     DateTime @db.Date
  openingStock             Int      @default(0)
  soldToday                Int      @default(0)
  otherInterestedCustomers Int      @default(0)
  reorderFlag              Boolean  @default(false)
  updatedAt                DateTime @updatedAt

  activationItem ActivationItem @relation(fields: [activationItemId], references: [id], onDelete: Cascade)

  @@unique([activationItemId, date])
  @@index([activationItemId])
  @@map("sales_records")
}

model DailyStats {
  id           String   @id @default(uuid())
  activationId String
  date         DateTime @db.Date
  footFall     Int      @default(0)
  approached   Int      @default(0)
  converted    Int      @default(0)
  updatedAt    DateTime @updatedAt

  activation Activation @relation(fields: [activationId], references: [id], onDelete: Cascade)

  @@unique([activationId, date])
  @@index([activationId])
  @@map("daily_stats")
}

model SalesSummary {
  id           String    @id @default(uuid())
  activationId String
  date         DateTime  @db.Date
  remarks      String?
  confirmed    Boolean   @default(false)
  confirmedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  activation Activation @relation(fields: [activationId], references: [id], onDelete: Cascade)

  @@unique([activationId, date])
  @@index([activationId])
  @@map("sales_summaries")
}

model TrackingPing {
  id              String   @id @default(uuid())
  activationId    String
  latitude        Float
  longitude       Float
  accuracyMeters  Float?
  capturedAt      DateTime
  receivedAt      DateTime @default(now())
  appState        AppState @default(foreground)
  batteryPercent  Int?

  activation Activation @relation(fields: [activationId], references: [id], onDelete: Cascade)

  @@index([activationId, capturedAt])
  @@map("tracking_pings")
}

model LeaveRequest {
  id           String      @id @default(uuid())
  staffId      String
  fromDate     DateTime    @db.Date
  toDate       DateTime    @db.Date
  reason       LeaveReason
  note         String?
  status       LeaveStatus @default(pending)
  approverId   String?
  createdAt    DateTime    @default(now())
  decidedAt    DateTime?

  staff             Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]

  @@index([staffId])
  @@map("leave_requests")
}

model SupervisorTask {
  id         String             @id @default(uuid())
  campaignId String
  category   String
  taskType   SupervisorTaskType
  task       String
  createdAt  DateTime           @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("supervisor_tasks")
}

// SupervisorRoute — Assign Routes (supervisor route planning) — NEW in v3.
// Previously had no backend entity anywhere; built now per this pass's scope
// decision. Deliberately campaign-scoped (campaignId + outletIds within that
// campaign) rather than fully global, so it slots into the same
// requireCampaignAccess / CampaignAccessGrant enforcement as every other
// campaign-scoped resource, instead of needing a special-cased global route.
// See Backend Spec v3 §4.2 and §5.9, and Changelog v3.
model SupervisorRoute {
  id                String   @id @default(uuid())
  campaignId        String
  supervisorStaffId String
  outletIds         String[] @default([])
  dateFrom          DateTime @db.Date
  dateTo            DateTime @db.Date
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  supervisor Staff    @relation(fields: [supervisorStaffId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([supervisorStaffId])
  @@map("supervisor_routes")
}

// ============================================================================
// Web portal RBAC: User / Role / CampaignAccessGrant
// ============================================================================

model Role {
  id           String   @id // short code, e.g. "adm", "usr", "supervisor", "sponsor"
  label        String
  description  String?
  modules      String[] @default([])
  functionality String[] @default([])
  defaultUrl   String
  isActive     Boolean  @default(true)

  users User[]

  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  displayName  String
  email        String?
  roleId       String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role          Role                  @relation(fields: [roleId], references: [id])
  accessGrants  CampaignAccessGrant[]
  staffProfile  Staff?

  @@index([roleId])
  @@map("users")
}

model CampaignAccessGrant {
  id          String          @id @default(uuid())
  userId      String
  campaignId  String
  scopeType   OutletScopeType @default(all)
  outletIds   String[]        @default([]) // used only when scopeType = subset
  createdAt   DateTime        @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
  @@index([userId])
  @@index([campaignId])
  @@map("campaign_access_grants")
}
