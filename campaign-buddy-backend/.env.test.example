# Copy to .env.test. DATABASE_URL must end in `_test` — the reset helper
# refuses to touch anything else. Create the DB and run migrations once:
#
#   psql -h localhost -p 5433 -U postgres -c "CREATE DATABASE campaign_buddy_test"
#   set -a; source .env.test; npx prisma migrate deploy
#   npm test
#
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/campaign_buddy_test?schema=public"
STAFF_JWT_SECRET="test-staff-secret"
USER_JWT_SECRET="test-user-secret"
