DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campaign_buddy?schema=public"
PORT=4000

STAFF_JWT_SECRET="change-me-staff-secret"
STAFF_JWT_EXPIRES_IN=86400
STAFF_REFRESH_TOKEN_TTL_DAYS=30

USER_JWT_SECRET="change-me-user-secret"
USER_JWT_EXPIRES_IN="8h"

BCRYPT_SALT_ROUNDS=10

# License usage tracking (docs/license-usage-spec.md)
# Global "near limit" warn threshold, percent of cap (1-99). Default 80.
LICENSE_WARN_THRESHOLD_PCT=80
# Set to 1 to disable the daily in-process usage-snapshot job.
LICENSE_SNAPSHOT_DISABLED=0

# Portal "Report an issue" -> GitHub Issues (docs/issue-reporting-spec.md)
# Reports are always saved to the database. They are only mirrored to GitHub
# when ENABLED=1 AND a token + repo are set. Until then they queue as `pending`
# and the hourly retry job flushes them once configured.
GITHUB_ISSUES_ENABLED=0
GITHUB_ISSUES_REPO="rajitha666/Campaign-Buddy-V2"
# Fine-grained PAT with "Issues: Read and write" on the repo above. Keep secret.
GITHUB_TOKEN=""
# Labels applied to every issue opened from the portal (comma-separated).
GITHUB_ISSUES_DEFAULT_LABELS="portal,from-portal"
# GitHub Enterprise only — defaults to https://api.github.com
# GITHUB_API_URL="https://github.example.com/api/v3"
# Set to 1 to disable the hourly retry job.
ISSUE_SYNC_DISABLED=0
