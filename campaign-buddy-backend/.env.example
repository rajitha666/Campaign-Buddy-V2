DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campaign_buddy?schema=public"
PORT=4000

STAFF_JWT_SECRET="change-me-staff-secret"
STAFF_JWT_EXPIRES_IN=86400
STAFF_REFRESH_TOKEN_TTL_DAYS=30

USER_JWT_SECRET="change-me-user-secret"
USER_JWT_EXPIRES_IN="8h"

BCRYPT_SALT_ROUNDS=10

# License usage tracking (docs/license-usage-spec.md)
# Global "near limit" warn threshold, percent of cap (1-99). Default 80.
LICENSE_WARN_THRESHOLD_PCT=80
# Set to 1 to disable the daily in-process usage-snapshot job.
LICENSE_SNAPSHOT_DISABLED=0

# Portal "Report an issue" -> GitHub Issues (docs/issue-reporting-spec.md)
# Reports are always saved to the database. They are only mirrored to GitHub
# when ENABLED=1 AND a token + repo are set. Until then they queue as `pending`
# and the hourly retry job flushes them once configured.
GITHUB_ISSUES_ENABLED=0
GITHUB_ISSUES_REPO="rajitha666/Campaign-Buddy-V2"
# Fine-grained PAT — needs "Issues: Read and write" (issue mirroring above)
# AND "Actions: Read" (portal "System Status" page's CI status, below). Keep secret.
GITHUB_TOKEN=""
# Labels applied to every issue opened from the portal (comma-separated).
GITHUB_ISSUES_DEFAULT_LABELS="portal,from-portal"
# GitHub Enterprise only — defaults to https://api.github.com
# GITHUB_API_URL="https://github.example.com/api/v3"
# Set to 1 to disable the hourly retry job.
ISSUE_SYNC_DISABLED=0

# Portal "System Status" page: shows the backend version and the latest
# .github/workflows/ci.yml run's per-job pass/fail. Reuses GITHUB_TOKEN +
# GITHUB_ISSUES_REPO above (same repo) — no separate config. Shows as
# "not configured" until both are set.

# AI-assisted features (src/utils/ai.ts) — framework only, no feature calls it yet.
# Set to 1 once a feature is wired up; leave 0 (default) to keep it a no-op.
AI_ENABLED=0
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# ---------------------------------------------------------------------------
# Tenant identity + app compatibility (docs/multi-tenant-release-strategy.md)
# ---------------------------------------------------------------------------
# One store binary serves every agency, so each deployment tells the app who it
# is and what it supports via the public GET /v1/meta. In production these come
# from the tenant's registry entry (tenants/<slug>.yaml); unset is fine locally.
TENANT_SLUG=""
TENANT_NAME=""

# Hard floor: an app below this gets 426 + a blocking upgrade screen. Leave
# empty to accept any app build (the dev default).
APP_MIN_SUPPORTED_VERSION=""
# Soft nudge only — the app shows a dismissible "update available" prompt.
APP_RECOMMENDED_VERSION=""
# Which self-hosted OTA bundle stream this server expects. Keeps a tenant on an
# older backend from pulling JS built against a newer contract.
APP_UPDATE_CHANNEL=""

# Capabilities to switch OFF for this tenant (comma-separated, from the list in
# src/utils/meta.ts). The app hides the matching screen instead of erroring.
FEATURES_DISABLED=""
