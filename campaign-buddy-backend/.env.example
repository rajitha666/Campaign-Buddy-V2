DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campaign_buddy?schema=public"
PORT=4000

STAFF_JWT_SECRET="change-me-staff-secret"
STAFF_JWT_EXPIRES_IN=86400
STAFF_REFRESH_TOKEN_TTL_DAYS=30

USER_JWT_SECRET="change-me-user-secret"
USER_JWT_EXPIRES_IN="8h"

BCRYPT_SALT_ROUNDS=10

# License usage tracking (docs/license-usage-spec.md)
# Global "near limit" warn threshold, percent of cap (1-99). Default 80.
LICENSE_WARN_THRESHOLD_PCT=80
# Set to 1 to disable the daily in-process usage-snapshot job.
LICENSE_SNAPSHOT_DISABLED=0
