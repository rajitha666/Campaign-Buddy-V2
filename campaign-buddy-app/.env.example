# The backend's /v1 base URL. Baked into the JS bundle at build time.
#
#  - Expo web / iOS Simulator / Android emulator on THIS machine:
#      http://localhost:4000/v1
#  - Physical device via Expo Go (same Wi-Fi): this machine's LAN IP, e.g.
#      http://10.0.0.69:4000/v1        (run `ipconfig` / `ifconfig` to find it)
#  - Expo Go over `--tunnel` (any network): still needs a publicly reachable
#      backend URL; localhost/LAN IPs will NOT work through the tunnel.
#
# Blank = the placeholder in src/api/client.ts.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# Where the "Field guide" links (Profile screen + the ? on Home). Opens in the
# device browser. Blank = the production default in src/lib/trainingGuide.ts
# (https://campaignbuddy.lk/training/promoter.html). Point it at a LAN IP to
# test against a local marketing server.
EXPO_PUBLIC_TRAINING_URL=
